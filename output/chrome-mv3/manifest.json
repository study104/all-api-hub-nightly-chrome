{
  "manifest_version": 3,
  "name": "自助签到中转站",
  "description": "多站点多账号签到管理：一键自动关公告、填账密、登录",
  "version": "0.2.3",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "version_name": "0.2.3-build-20261124-saved-login-options",
  "action": { "default_title": "打开自助签到中转站" },
  "permissions": [
    "storage",
    "tabs",
    "favicon",
    "scripting",
    "cookies",
    "debugger",
    "bookmarks",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "alarms",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/checkin-service.js" },
  "options_ui": { "open_in_tab": true, "page": "options.html" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content-scripts/auto-login.js"]
    }
  ]
}
