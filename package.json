{
  "name": "all-api-hub-chrome-maintenance",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Chrome 扩展打包代码的排版和资源引用检查工具",
  "scripts": {
    "build": "node scripts/build-extension.cjs",
    "preview:login": "node scripts/preview-login-ui.cjs",
    "build:legacy-root": "node scripts/build-extension.cjs --legacy-root",
    "clean:legacy-root": "node scripts/build-extension.cjs --clean-legacy-root",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run build && npm test && npm run check && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-extension.cjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint-scope": "9.1.2",
    "prettier": "3.10.1"
  }
}
